# =============================================================================
# LOCAL DEV — bu faylı .env.local adı ilə kopyalayın (git-ə düşmür)
# =============================================================================
# Dev bazası (Neon/Vercel Postgres — ayrı "vlaecci-dev" store)
DATABASE_URL="postgresql://USER:PASSWORD@DEV-HOST/neondb?sslmode=require"

JWT_SECRET="dev-secret-change-me"
ADMIN_EMAIL="admin@vlaecci.com"
ADMIN_PASSWORD="admin123"
NEXT_PUBLIC_WHATSAPP_NUMBER="+994501234567"
NEXT_PUBLIC_INSTAGRAM_USERNAME="vlaecci"

# =============================================================================
# VERCEL — iki ayrı Postgres store yaradın:
#   1) vlaecci-prod  → yalnız Production mühiti
#   2) vlaecci-dev   → Preview + Development mühitləri
#
# Hər store-u layihəyə Connect edəndə DATABASE_URL avtomatik əlavə olunur.
# Eyni adlı DATABASE_URL varsa, hər mühit üçün düzgün store-u seçin:
#
#   Settings → Environment Variables → DATABASE_URL
#     ☑ Production     → vlaecci-prod connection string
#     ☑ Preview        → vlaecci-dev connection string
#     ☑ Development    → vlaecci-dev connection string
#
# Prod (vlaecci.com) və dev (vercel.app / lokal) tamamilə ayrı məlumat saxlayır.
# =============================================================================

# Prod üçün (Vercel Production mühiti):
# DATABASE_URL="postgresql://...@PROD-HOST/neondb?sslmode=require"

# JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD də mühitə görə fərqli ola bilər:
# Production-da güclü parol, Preview/Dev-də test parolu istifadə edin.

# Vercel Blob — hər iki mühit üçün eyni və ya ayrı store (istəyə görə)
# BLOB_READ_WRITE_TOKEN avtomatik əlavə olunur
